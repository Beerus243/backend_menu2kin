# Mode explicite : demo (fixtures, interdit en production) ou postgres.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGINS=http://localhost:8080

CATALOG_SOURCE=demo
# Clé temporaire des endpoints admin catalogue ; utiliser un secret manager en production.
ADMIN_API_KEY=
ADMIN_ACTOR=local-admin
# Générer une clé : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Base locale du compose.yaml ; exporter la variable pour les commandes DB.
DATABASE_URL=postgresql://menu2kin:local_development_only@127.0.0.1:55432/menu2kin
